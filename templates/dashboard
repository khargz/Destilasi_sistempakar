_chartJs.src = 'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js';
document.head.appendChild(_chartJs);

setInterval(checkDB, 15000);
setInterval(fetchLatestData, 3000);
