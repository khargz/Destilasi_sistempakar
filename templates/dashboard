<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Sistem Pakar — Distilasi Minyak Kayu Putih</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#0d1117;--bg2:#161b22;--bg3:#1c2330;
    --border:#30363d;--border2:#21262d;
    --text:#e6edf3;--text2:#8b949e;--text3:#484f58;
    --green:#3fb950;--green-dim:#1a3a22;
    --amber:#d29922;--amber-dim:#3a2a0a;
    --red:#f85149;--red-dim:#3a1a1a;
    --blue:#58a6ff;--blue-dim:#1a2a3a;
    --teal:#39d0c4;--teal-dim:rgba(57,208,196,.08);
    --mono:'IBM Plex Mono',monospace;
    --sans:'IBM Plex Sans',sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font-family:var(--sans);font-size:14px;min-height:100vh}

  /* ═══════════════════════════════════════
     LOGIN SCREEN
  ═══════════════════════════════════════ */
  #login-screen {
    position:fixed;inset:0;z-index:9999;
    background:var(--bg);
    display:flex;align-items:center;justify-content:center;
    flex-direction:column;
  }
  .login-grid-bg {
    position:absolute;inset:0;
    background-image:
      linear-gradient(rgba(57,208,196,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(57,208,196,.04) 1px, transparent 1px);
    background-size:40px 40px;
    mask-image:radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
  }
  .login-glow {
    position:absolute;
    width:600px;height:600px;
    background:radial-gradient(circle, rgba(57,208,196,.07) 0%, transparent 70%);
    top:50%;left:50%;transform:translate(-50%,-50%);
    pointer-events:none;
  }
  .login-box {
    position:relative;z-index:1;
    width:420px;
    background:var(--bg2);
    border:1px solid var(--border);
    border-radius:12px;
    overflow:hidden;
    animation:loginSlideIn .5s ease;
  }
  @keyframes loginSlideIn {
    from{opacity:0;transform:translateY(24px)}
    to{opacity:1;transform:none}
  }
  .login-header {
    padding:28px 32px 24px;
    border-bottom:1px solid var(--border2);
    background:linear-gradient(to bottom, rgba(57,208,196,.04), transparent);
  }
  .login-brand {
    display:flex;align-items:center;gap:10px;margin-bottom:16px;
  }
  .login-logo {
    width:36px;height:36px;border-radius:8px;
    border:1px solid rgba(57,208,196,.3);
    background:rgba(57,208,196,.06);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--mono);font-size:11px;font-weight:500;color:var(--teal);
    letter-spacing:.02em;
  }
  .login-brand-name {
    font-family:var(--mono);font-size:14px;font-weight:500;color:var(--teal);
    letter-spacing:.06em;
  }
  .login-subtitle {
    font-size:12px;color:var(--text3);
    font-family:var(--mono);
    line-height:1.6;
  }
  .login-title {
    font-size:18px;font-weight:500;color:var(--text);margin-bottom:4px;
  }
  .login-body { padding:28px 32px 32px; }
  .login-field { margin-bottom:18px; }
  .login-label {
    font-family:var(--mono);font-size:10px;text-transform:uppercase;
    letter-spacing:.08em;color:var(--text3);margin-bottom:7px;display:block;
  }
  .login-input-wrap { position:relative; }
  .login-input {
    width:100%;background:var(--bg3);
    border:1px solid var(--border);border-radius:6px;
    padding:10px 38px 10px 12px;
    font-family:var(--mono);font-size:13px;
    color:var(--text);outline:none;
    transition:border-color .2s, box-shadow .2s;
  }
  .login-input:focus {
    border-color:rgba(57,208,196,.5);
    box-shadow:0 0 0 3px rgba(57,208,196,.08);
  }
  .login-input.error { border-color:rgba(248,81,73,.5); }
  .login-input-icon {
    position:absolute;right:11px;top:50%;transform:translateY(-50%);
    font-size:15px;color:var(--text3);cursor:pointer;user-select:none;
    transition:color .2s;
  }
  .login-input-icon:hover { color:var(--text2); }
  .login-hint {
    font-family:var(--mono);font-size:10px;color:var(--text3);
    margin-top:5px;
  }
  .login-error {
    background:var(--red-dim);border:1px solid rgba(248,81,73,.3);
    border-radius:5px;padding:8px 12px;
    font-family:var(--mono);font-size:11px;color:var(--red);
    margin-bottom:16px;display:none;
    animation:shake .3s ease;
  }
  @keyframes shake {
    0%,100%{transform:translateX(0)}
    20%,60%{transform:translateX(-6px)}
    40%,80%{transform:translateX(6px)}
  }
  .login-btn {
    width:100%;padding:11px;
    background:rgba(57,208,196,.1);
    border:1px solid rgba(57,208,196,.35);
    border-radius:6px;color:var(--teal);
    font-family:var(--mono);font-size:12px;font-weight:500;
    letter-spacing:.06em;text-transform:uppercase;
    cursor:pointer;transition:all .2s;
    position:relative;overflow:hidden;
  }
  .login-btn:hover {
    background:rgba(57,208,196,.18);
    border-color:rgba(57,208,196,.6);
    box-shadow:0 0 20px rgba(57,208,196,.12);
  }
  .login-btn:active { transform:scale(.98); }
  .login-btn.loading { pointer-events:none;opacity:.7; }
  .login-footer {
    padding:14px 32px;border-top:1px solid var(--border2);
    background:rgba(0,0,0,.2);
    display:flex;align-items:center;justify-content:space-between;
  }
  .login-footer-text {
    font-family:var(--mono);font-size:10px;color:var(--text3);
  }
  .login-footer-dot {
    width:6px;height:6px;border-radius:50%;background:var(--green);
    animation:pulse 1.5s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

  /* User badge di topbar */
  .user-badge {
    display:flex;align-items:center;gap:8px;
    background:var(--bg3);border:1px solid var(--border);
    border-radius:6px;padding:4px 10px;cursor:pointer;
    transition:all .2s;position:relative;
  }
  .user-badge:hover { border-color:var(--border2);background:var(--bg2); }
  .user-avatar {
    width:22px;height:22px;border-radius:50%;
    background:rgba(57,208,196,.15);border:1px solid rgba(57,208,196,.3);
    font-family:var(--mono);font-size:9px;font-weight:500;color:var(--teal);
    display:flex;align-items:center;justify-content:center;
  }
  .user-name { font-family:var(--mono);font-size:11px;color:var(--text2); }
  .user-menu {
    position:absolute;top:calc(100% + 6px);right:0;
    background:var(--bg2);border:1px solid var(--border);
    border-radius:7px;padding:6px;min-width:160px;
    display:none;z-index:999;
    box-shadow:0 8px 24px rgba(0,0,0,.4);
    animation:menuDrop .15s ease;
  }
  @keyframes menuDrop{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
  .user-badge:hover .user-menu { display:block; }
  .user-menu-item {
    padding:8px 10px;border-radius:5px;cursor:pointer;
    font-family:var(--mono);font-size:11px;color:var(--text2);
    display:flex;align-items:center;gap:8px;transition:background .15s;
  }
  .user-menu-item:hover { background:var(--bg3);color:var(--text); }
  .user-menu-item.danger:hover { background:var(--red-dim);color:var(--red); }
  .user-menu-sep { height:1px;background:var(--border2);margin:4px 0; }

  /* ═══════════════════════════════════════
     DASHBOARD
  ═══════════════════════════════════════ */
  #dashboard-screen { display:none; }

  .topbar{background:var(--bg2);border-bottom:1px solid var(--border);padding:0 24px;height:52px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
  .topbar-logo{font-family:var(--mono);font-size:13px;font-weight:500;color:var(--teal);letter-spacing:.04em}
  .topbar-sep{width:1px;height:20px;background:var(--border);margin:0 12px}
  .topbar-title{font-size:13px;color:var(--text2)}
  .topbar-right{display:flex;align-items:center;gap:12px}
  .live-badge{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:11px;color:var(--green);background:var(--green-dim);border:1px solid rgba(63,185,80,.3);padding:3px 10px;border-radius:4px}
  .live-dot{width:6px;height:6px;border-radius:50%;background:var(--green);animation:pulse 1.5s ease-in-out infinite}
  .db-badge{font-family:var(--mono);font-size:11px;padding:3px 10px;border-radius:4px;border:1px solid var(--border)}
  .db-badge.connected{color:var(--green);background:var(--green-dim);border-color:rgba(63,185,80,.3)}
  .db-badge.disconnected{color:var(--red);background:var(--red-dim);border-color:rgba(248,81,73,.3)}
  .clock{font-family:var(--mono);font-size:12px;color:var(--text3)}

  .main{padding:20px 24px;max-width:1400px;margin:0 auto}

  /* WELCOME BAR */
  .welcome-bar {
    background:var(--bg2);border:1px solid var(--border);border-radius:8px;
    padding:12px 20px;margin-bottom:16px;
    display:flex;align-items:center;justify-content:space-between;
    animation:fadeUp .4s ease;
  }
  @keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .welcome-text { font-size:13px;color:var(--text2); }
  .welcome-text span { color:var(--teal);font-weight:500; }
  .welcome-session { font-family:var(--mono);font-size:10px;color:var(--text3); }

  /* STATUS BANNER */
  .status-banner{border:1px solid var(--border);border-radius:8px;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;transition:all .4s}
  .status-banner.normal{background:var(--green-dim);border-color:rgba(63,185,80,.4)}
  .status-banner.anomali{background:var(--amber-dim);border-color:rgba(210,153,34,.4)}
  .status-banner.kritis{background:var(--red-dim);border-color:rgba(248,81,73,.4)}
  .banner-status{font-size:15px;font-weight:600;margin-bottom:2px}
  .banner-status.normal{color:var(--green)}
  .banner-status.anomali{color:var(--amber)}
  .banner-status.kritis{color:var(--red)}
  .banner-desc{font-size:12px;color:var(--text2)}
  .banner-right{text-align:right}
  .banner-time{font-family:var(--mono);font-size:11px;color:var(--text3)}
  .banner-saved{font-family:var(--mono);font-size:10px;margin-top:4px}
  .banner-saved.ok{color:var(--green)}
  .banner-saved.err{color:var(--red)}

  /* SENSOR GRID */
  .sensor-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
  .sensor-card{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:16px;position:relative;overflow:hidden;transition:border-color .3s,transform .15s,box-shadow .15s;cursor:pointer}
  .sensor-card:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.3)}
  .sensor-card.warn{border-color:rgba(210,153,34,.5)}
  .sensor-card.danger{border-color:rgba(248,81,73,.5)}
  .sensor-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;transition:background .3s}
  .sensor-card.ok::before{background:var(--green)}
  .sensor-card.warn::before{background:var(--amber)}
  .sensor-card.danger::before{background:var(--red)}
  .sc-label{font-size:11px;color:var(--text3);font-family:var(--mono);letter-spacing:.05em;text-transform:uppercase;margin-bottom:10px}
  .sc-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .sc-badge{font-size:10px;font-family:var(--mono);padding:2px 7px;border-radius:3px}
  .sc-badge.ok{background:var(--green-dim);color:var(--green)}
  .sc-badge.warn{background:var(--amber-dim);color:var(--amber)}
  .sc-badge.danger{background:var(--red-dim);color:var(--red)}
  .sc-value{font-family:var(--mono);font-size:28px;font-weight:500;line-height:1}
  .sc-value.ok{color:var(--text)}
  .sc-value.warn{color:var(--amber)}
  .sc-value.danger{color:var(--red)}
  .sc-unit{font-family:var(--mono);font-size:13px;color:var(--text3);margin-left:4px}
  .sc-range{font-size:11px;color:var(--text3);margin-top:8px;font-family:var(--mono)}
  .sc-trend{font-size:11px;color:var(--text2);margin-top:4px}
  .sparkline{margin-top:10px}

  /* SENSOR TOOLTIP MODAL */
  .modal-overlay {
    position:fixed;inset:0;z-index:500;
    background:rgba(0,0,0,.6);backdrop-filter:blur(4px);
    display:none;align-items:center;justify-content:center;
  }
  .modal-overlay.open { display:flex; }
  .modal-box {
    background:var(--bg2);border:1px solid var(--border);
    border-radius:10px;width:460px;max-width:90vw;
    animation:modalIn .2s ease;
  }
  @keyframes modalIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:none}}
  .modal-header {
    padding:16px 20px;border-bottom:1px solid var(--border2);
    display:flex;align-items:center;justify-content:space-between;
  }
  .modal-title { font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--teal); }
  .modal-close {
    width:24px;height:24px;border-radius:4px;
    background:transparent;border:1px solid var(--border);
    color:var(--text3);cursor:pointer;font-size:14px;
    display:flex;align-items:center;justify-content:center;
    transition:all .15s;
  }
  .modal-close:hover { background:var(--bg3);color:var(--text); }
  .modal-body { padding:20px; }
  .modal-stat-row {
    display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:16px;
  }
  .modal-stat {
    background:var(--bg3);border-radius:6px;padding:12px;text-align:center;
  }
  .modal-stat-val { font-family:var(--mono);font-size:20px;font-weight:500; }
  .modal-stat-lbl { font-size:10px;color:var(--text3);margin-top:4px;font-family:var(--mono); }
  .modal-chart-wrap { height:120px;margin-top:8px; }

  /* TABS */
  .tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:0}
  .tab{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.04em;padding:10px 16px;cursor:pointer;color:var(--text3);border-bottom:2px solid transparent;transition:all .2s}
  .tab:hover{color:var(--text2)}
  .tab.active{color:var(--teal);border-bottom-color:var(--teal)}
  .tab-content{display:none}
  .tab-content.active{display:block}

  /* GRID */
  .grid-main{display:grid;grid-template-columns:1fr 1fr 360px;gap:14px;margin-bottom:20px}
  .panel{background:var(--bg2);border:1px solid var(--border);border-radius:8px;overflow:hidden}
  .panel-header{padding:12px 16px;border-bottom:1px solid var(--border2);display:flex;align-items:center;justify-content:space-between}
  .panel-title{font-size:12px;font-weight:500;color:var(--text2);font-family:var(--mono);letter-spacing:.04em;text-transform:uppercase}
  .panel-body{padding:16px}

  /* FORWARD CHAINING */
  .fc-item{display:flex;gap:12px;padding:8px 0;border-bottom:1px solid var(--border2);animation:fadeIn .3s ease}
  .fc-item:last-child{border-bottom:none}
  @keyframes fadeIn{from{opacity:0;transform:translateX(-6px)}to{opacity:1;transform:none}}
  .fc-num{width:20px;height:20px;border-radius:3px;font-family:var(--mono);font-size:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
  .fc-num.ok{background:var(--green-dim);color:var(--green)}
  .fc-num.warn{background:var(--amber-dim);color:var(--amber)}
  .fc-num.danger{background:var(--red-dim);color:var(--red)}
  .fc-rule{font-size:11px;font-family:var(--mono);color:var(--text3);margin-bottom:2px}
  .fc-result{font-size:13px;color:var(--text)}
  .fc-result span.ok{color:var(--green);font-weight:500}
  .fc-result span.warn{color:var(--amber);font-weight:500}
  .fc-result span.danger{color:var(--red);font-weight:500}

  /* REKOMENDASI */
  .rek-item{padding:10px 14px;border-radius:6px;margin-bottom:8px;border-left:3px solid transparent;transition:background .2s;cursor:default}
  .rek-item:hover{filter:brightness(1.1)}
  .rek-item.ok{background:rgba(63,185,80,.07);border-color:var(--green)}
  .rek-item.warn{background:rgba(210,153,34,.08);border-color:var(--amber)}
  .rek-item.danger{background:rgba(248,81,73,.08);border-color:var(--red)}
  .rek-title{font-weight:500;margin-bottom:3px;font-size:13px}
  .rek-item.ok .rek-title{color:var(--green)}
  .rek-item.warn .rek-title{color:var(--amber)}
  .rek-item.danger .rek-title{color:var(--red)}
  .rek-desc{color:var(--text2);font-size:12px;line-height:1.5}

  /* NOTIF */
  .notif-item{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--border2)}
  .notif-item:last-child{border-bottom:none}
  .notif-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;margin-top:4px}
  .notif-dot.warn{background:var(--amber)}
  .notif-dot.danger{background:var(--red)}
  .notif-msg{font-size:12px;color:var(--text);line-height:1.5}
  .notif-time{font-family:var(--mono);font-size:10px;color:var(--text3);margin-top:2px}

  /* LOG TABLE */
  .log-wrap{overflow-x:auto;max-height:360px;overflow-y:auto}
  table{width:100%;border-collapse:collapse;font-size:12px}
  th{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--text3);padding:8px 12px;border-bottom:1px solid var(--border);text-align:left;position:sticky;top:0;background:var(--bg2)}
  td{padding:7px 12px;border-bottom:1px solid var(--border2);color:var(--text2);font-family:var(--mono)}
  tr:hover td{background:rgba(255,255,255,.02)}
  .log-status{display:inline-block;padding:2px 7px;border-radius:3px;font-size:10px}
  .log-status.normal{background:var(--green-dim);color:var(--green)}
  .log-status.anomali{background:var(--amber-dim);color:var(--amber)}
  .log-status.kritis{background:var(--red-dim);color:var(--red)}

  /* STATISTIK */
  .stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px}
  .stat-card{background:var(--bg3);border-radius:6px;padding:12px;text-align:center}
  .stat-val{font-family:var(--mono);font-size:24px;font-weight:500;color:var(--text)}
  .stat-label{font-size:11px;color:var(--text3);margin-top:4px}
  .stat-val.normal{color:var(--green)}
  .stat-val.anomali{color:var(--amber)}
  .stat-val.kritis{color:var(--red)}

  /* BUTTON */
  .btn{font-family:var(--mono);font-size:11px;padding:5px 12px;border-radius:4px;border:1px solid var(--border);background:none;color:var(--text2);cursor:pointer;transition:all .2s}
  .btn:hover{background:var(--bg3);color:var(--text)}
  .btn.primary{border-color:rgba(57,208,196,.4);color:var(--teal)}
  .btn.primary:hover{background:var(--teal-dim)}

  .footer-note{text-align:center;font-family:var(--mono);font-size:11px;color:var(--text3);padding:16px 0 8px;border-top:1px solid var(--border2);margin-top:8px}
  ::-webkit-scrollbar{width:5px;height:5px}
  ::-webkit-scrollbar-track{background:transparent}
  ::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}

  /* TOAST */
  .toast-wrap { position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px; }
  .toast {
    background:var(--bg2);border:1px solid var(--border);border-radius:7px;
    padding:10px 14px;font-family:var(--mono);font-size:11px;
    display:flex;align-items:center;gap:8px;
    box-shadow:0 4px 16px rgba(0,0,0,.4);
    animation:toastIn .25s ease;max-width:280px;
  }
  @keyframes toastIn{from{opacity:0;transform:translateX(16px)}to{opacity:1;transform:none}}
  .toast.ok{border-color:rgba(63,185,80,.4);color:var(--green)}
  .toast.warn{border-color:rgba(210,153,34,.4);color:var(--amber)}
  .toast.err{border-color:rgba(248,81,73,.4);color:var(--red)}


</style>
</head>
<body>

<!-- ══════════════════════ LOGIN SCREEN ══════════════════════ -->
<div id="login-screen">
  <div class="login-grid-bg"></div>
  <div class="login-glow"></div>

  <div class="login-box">
    <div class="login-header">
      <div class="login-brand">
        <div class="login-logo">ES</div>
        <div class="login-brand-name">EXPERT-SYS</div>
      </div>
      <div class="login-title">Masuk ke Dashboard</div>
      <div class="login-subtitle">Sistem Pakar Distilasi Minyak Kayu Putih · Forward Chaining</div>
    </div>

    <div class="login-body">
