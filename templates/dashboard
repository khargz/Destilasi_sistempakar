<script>
// ═══════════════════════════════════════════
// DATA PENGGUNA (simulasi — di produksi pakai backend)
// ═══════════════════════════════════════════
const USERS = {
  'admin':    { password:'admin123', fullname:'Administrator', role:'administrator · akses penuh',    initials:'AD' },
  'operator': { password:'op2024',   fullname:'Operator Lab',  role:'operator · akses monitoring',    initials:'OP' },
  'viewer':   { password:'view2024', fullname:'Viewer',        role:'viewer · hanya baca',             initials:'VW' },
};

let currentUser = null;
let loginTime = null;

// ═══════════════════════════════════════════
// LOGIN
// ═══════════════════════════════════════════
function togglePass() {
  const inp = document.getElementById('inp-pass');
  inp.type = inp.type === 'password' ? 'text' : 'password';
}

function doLogin() {
  const u = document.getElementById('inp-user').value.trim();
  const p = document.getElementById('inp-pass').value;
  const err = document.getElementById('login-error');
  const btn = document.getElementById('login-btn');

  // Clear error
  err.style.display = 'none';
  document.getElementById('inp-user').classList.remove('error');
  document.getElementById('inp-pass').classList.remove('error');

  if (!u || !p) {
    err.textContent = '⚠ Username dan password harus diisi';
    err.style.display = 'block';
    return;
  }

  const user = USERS[u.toLowerCase()];
  if (!user || user.password !== p) {
    err.textContent = '⚠ Username atau password salah';
    err.style.display = 'block';
    document.getElementById('inp-user').classList.add('error');
    document.getElementById('inp-pass').classList.add('error');
    document.getElementById('inp-pass').value = '';
    return;
  }

  // Loading state
  btn.classList.add('loading');
  document.getElementById('login-btn-text').textContent = 'MENGAUTENTIKASI...';

  setTimeout(() => {
    currentUser = { username: u.toLowerCase(), ...user };
    loginTime = new Date();

    // Update UI
    const initials = user.initials;
    document.getElementById('user-avatar').textContent = initials;
    document.getElementById('user-name-badge').textContent = u.toLowerCase();
    document.getElementById('menu-fullname').textContent = user.fullname;
    document.getElementById('menu-logintime').textContent = loginTime.toLocaleTimeString('id-ID');
    document.getElementById('welcome-name').textContent = user.fullname;
    document.getElementById('welcome-time').textContent = loginTime.toLocaleTimeString('id-ID');
    document.getElementById('welcome-session').textContent = 'role: ' + user.role;

    // Transition
    const ls = document.getElementById('login-screen');
    ls.style.transition = 'opacity .4s';
    ls.style.opacity = '0';
    setTimeout(() => {
      ls.style.display = 'none';
      document.getElementById('dashboard-screen').style.display = 'block';
      showToast('ok', '✓ Masuk sebagai ' + user.fullname);
      checkDB();
    }, 400);
  }, 800);
}

function doLogout() {
  if (!confirm('Yakin ingin keluar?')) return;
  document.getElementById('dashboard-screen').style.display = 'none';
  const ls = document.getElementById('login-screen');
  ls.style.opacity = '0';
  ls.style.display = 'flex';
  setTimeout(() => { ls.style.opacity = '1'; ls.style.transition = 'opacity .3s'; }, 10);
  document.getElementById('inp-user').value = '';
  document.getElementById('inp-pass').value = '';
  document.getElementById('login-btn').classList.remove('loading');
  document.getElementById('login-btn-text').textContent = 'MASUK →';
  document.getElementById('login-error').style.display = 'none';
  currentUser = null;
}

// ═══════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════
function showToast(type, msg, duration=3000) {
  const wrap = document.getElementById('toast-wrap');
  const t = document.createElement('div');
  t.className = 'toast ' + type;
  t.textContent = msg;
  wrap.appendChild(t);
  setTimeout(() => {
    t.style.transition = 'opacity .3s, transform .3s';
    t.style.opacity = '0'; t.style.transform = 'translateX(16px)';
    setTimeout(() => t.remove(), 300);
  }, duration);
}

// ═══════════════════════════════════════════
// MODAL SENSOR DETAIL
// ═══════════════════════════════════════════
const SENSOR_META = {
  sp:  { label:'SUHU PEMANAS',  unit:'°C',  min:90,  max:105 },
  sc:  { label:'SUHU PENDINGIN',unit:'°C',  min:20,  max:35  },
  ph:  { label:'pH HASIL',      unit:'',    min:5.5, max:7.0 },
  tds: { label:'TDS HASIL',     unit:'ppm', min:50,  max:300 },
};
let modalChart = null;

function openModal(param) {
  const meta = SENSOR_META[param];
  const data = hist[param];
  if (!data || data.length < 2) { showToast('warn','⚠ Belum cukup data untuk ditampilkan'); return; }

  document.getElementById('modal-title').textContent = 'DETAIL — ' + meta.label;
  const cur = data[data.length-1];
  const mn = Math.min(...data), mx = Math.max(...data);
  const fix = param==='tds' ? 0 : param==='ph' ? 2 : 1;
  document.getElementById('modal-cur').textContent = cur.toFixed(fix) + meta.unit;
  document.getElementById('modal-min').textContent = mn.toFixed(fix) + meta.unit;
  document.getElementById('modal-max').textContent = mx.toFixed(fix) + meta.unit;

  const inRange = cur >= meta.min && cur <= meta.max;
  const statusTxt = inRange
    ? `✓ Nilai ${cur.toFixed(fix)}${meta.unit} — dalam rentang ideal [${meta.min}–${meta.max}${meta.unit}]`
    : `⚠ Nilai ${cur.toFixed(fix)}${meta.unit} — di luar rentang ideal [${meta.min}–${meta.max}${meta.unit}]`;
  const statusEl = document.getElementById('modal-status-line');
  statusEl.textContent = statusTxt;
  statusEl.style.color = inRange ? 'var(--green)' : 'var(--amber)';

  document.getElementById('modal-overlay').classList.add('open');

  // Draw chart
  if (modalChart) { modalChart.destroy(); modalChart = null; }
  const canvas = document.getElementById('modal-chart');
  const ctx = canvas.getContext('2d');
  const color = colOf(paramSt(param, RULES.filter(r => r.cond({sp,sc,ph,tds}))));

  modalChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: data.map((_,i) => i===data.length-1 ? 'now' : -(data.length-1-i)+'s'),
      datasets: [{
        data, borderColor: color,
        backgroundColor: color+'18',
        borderWidth: 1.5, pointRadius: 2,
        pointBackgroundColor: color,
        tension: 0.4, fill: true,
      }]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      animation:{duration:400},
      plugins:{ legend:{display:false}, tooltip:{
        callbacks:{ label: ctx => ctx.parsed.y.toFixed(fix)+meta.unit }
      }},
      scales:{
        x:{ grid:{color:'rgba(255,255,255,.04)'}, ticks:{color:'#484f58',font:{size:9}} },
        y:{ grid:{color:'rgba(255,255,255,.04)'}, ticks:{color:'#484f58',font:{size:9}} }
      }
    }
  });
}

function closeModal() {
  document.getElementById('modal-overlay').classList.remove('open');
}
document.addEventListener('keydown', e => { if(e.key==='Escape') closeModal(); });

