// ═══════════════════════════════════════════
// KODE DASHBOARD ORIGINAL (tidak diubah)
// ═══════════════════════════════════════════
const API = '/api';
let dbOk = false;

const RULES = [
  {id:'R01',cond:d=>d.sp>=90&&d.sp<=105,param:'sp',status:'ok',label:'Suhu pemanas normal',rek:null},
  {id:'R02',cond:d=>d.sp<90,param:'sp',status:'warn',label:'Suhu pemanas terlalu rendah',rek:{cls:'warn',title:'Naikkan suhu pemanas',desc:'Di bawah 90°C menyebabkan yield rendah.'}},
  {id:'R03',cond:d=>d.sp>105&&d.sp<=112,param:'sp',status:'warn',label:'Suhu sedikit tinggi',rek:{cls:'warn',title:'Turunkan suhu pemanas',desc:'Di atas 105°C berisiko degradasi senyawa.'}},
  {id:'R04',cond:d=>d.sp>112,param:'sp',status:'danger',label:'KRITIS: Suhu sangat tinggi',rek:{cls:'danger',title:'MATIKAN PEMANAS SEGERA',desc:'Melebihi 112°C. Bahaya.'}},
  {id:'R05',cond:d=>d.sc>=20&&d.sc<=35,param:'sc',status:'ok',label:'Suhu pendingin normal',rek:null},
  {id:'R06',cond:d=>d.sc<20,param:'sc',status:'warn',label:'Suhu pendingin rendah',rek:{cls:'warn',title:'Kurangi aliran air',desc:'Di bawah 20°C menyebabkan minyak bercampur air.'}},
  {id:'R07',cond:d=>d.sc>35,param:'sc',status:'danger',label:'KRITIS: Suhu pendingin tinggi',rek:{cls:'danger',title:'Tingkatkan aliran air',desc:'Kondensasi gagal.'}},
  {id:'R08',cond:d=>d.ph>=5.5&&d.ph<=7.0,param:'ph',status:'ok',label:'pH normal (SNI)',rek:null},
  {id:'R09',cond:d=>d.ph<5.5,param:'ph',status:'warn',label:'pH terlalu asam',rek:{cls:'warn',title:'Periksa keasaman',desc:'Cek kebersihan tangki.'}},
  {id:'R10',cond:d=>d.ph>7.0,param:'ph',status:'warn',label:'pH terlalu basa',rek:{cls:'warn',title:'Turunkan pemanas',desc:'Fraksi berat ikut terdestilasi.'}},
  {id:'R11',cond:d=>d.tds>=50&&d.tds<=300,param:'tds',status:'ok',label:'TDS normal',rek:null},
  {id:'R12',cond:d=>d.tds<50,param:'tds',status:'warn',label:'TDS rendah',rek:{cls:'warn',title:'Minyak terlalu encer',desc:'Cek bahan baku daun.'}},
  {id:'R13',cond:d=>d.tds>300&&d.tds<=500,param:'tds',status:'warn',label:'TDS tinggi',rek:{cls:'warn',title:'Periksa kontaminan mineral',desc:'Kualitas air buruk.'}},
  {id:'R14',cond:d=>d.tds>500,param:'tds',status:'danger',label:'KRITIS: TDS sangat tinggi',rek:{cls:'danger',title:'HENTIKAN PROSES',desc:'Indikasi kontaminasi serius.'}},
];

let sp=0,sc=0,ph=0,tds=0;
let prevSp=0,prevSc=0,prevPh=0,prevTds=0;
const hist={sp:[],sc:[],ph:[],tds:[]};
const MAX_H=20;
let prevFired=[];
const localNotifs=[];

setInterval(()=>{ document.getElementById('clock').textContent=new Date().toLocaleTimeString('id-ID'); },1000);

function switchTab(t){
  document.querySelectorAll('.tab').forEach(el=>el.classList.toggle('active',el.textContent.toLowerCase().includes(t==='log'?'log':'statistik')));
  document.getElementById('tab-log').classList.toggle('active',t==='log');
  document.getElementById('tab-statistik').classList.toggle('active',t==='statistik');
  if(t==='statistik') loadStatistik();
}

function drawSpark(id,data,color){
  const c=document.getElementById(id); if(!c||data.length<2)return;
  const ctx=c.getContext('2d'),W=c.width,H=c.height; ctx.clearRect(0,0,W,H);
  const mn=Math.min(...data),mx=Math.max(...data),rng=mx-mn||1;
  const pts=data.map((v,i)=>({x:(i/(data.length-1))*W,y:H-((v-mn)/rng)*(H-6)-3}));
  ctx.beginPath();ctx.strokeStyle=color;ctx.lineWidth=1.5;ctx.lineJoin='round';
  pts.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y)); ctx.stroke();
  ctx.beginPath(); pts.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));
  ctx.lineTo(pts[pts.length-1].x,H);ctx.lineTo(pts[0].x,H);ctx.closePath();
  ctx.fillStyle=color+'22';ctx.fill();
}
function colOf(s){return s==='ok'?'#3fb950':s==='warn'?'#d29922':'#f85149';}
function paramSt(param,fired){const r=fired.find(f=>f.param===param);return r?r.status:'ok';}

function updCard(id,val,st,disp,prev){
  document.getElementById('card-'+id).className='sensor-card '+st;
  const ve=document.getElementById('val-'+id);ve.className='sc-value '+st;ve.textContent=disp;
  const be=document.getElementById('badge-'+id);be.className='sc-badge '+st;
  be.textContent=st==='ok'?'NORMAL':st==='warn'?'PERINGATAN':'KRITIS';
  const d=val-prev,arr=d>0.05?'↑':d<-0.05?'↓':'→';
  const te=document.getElementById('trend-'+id);
  te.textContent=arr+' '+(d>=0?'+':'')+d.toFixed(1); te.style.color=colOf(st);
}

function updBanner(ov,fired){
  const b=document.getElementById('status-banner');
  b.className='status-banner '+(ov==='normal'?'normal':ov==='anomali'?'anomali':'kritis');
  const s=document.getElementById('banner-status');
  s.className='banner-status '+(ov==='normal'?'normal':ov==='anomali'?'anomali':'kritis');
  s.textContent=ov==='normal'?'DISTILASI BERJALAN NORMAL':ov==='anomali'?'ANOMALI TERDETEKSI':'KONDISI KRITIS — TINDAKAN SEGERA DIPERLUKAN';
  const issues=fired.filter(r=>r.status!=='ok');
  document.getElementById('banner-desc').textContent=issues.length?issues.map(r=>r.label).join(' · '):'Semua parameter dalam batas ideal';
  document.getElementById('banner-time').textContent='Update: '+new Date().toLocaleTimeString('id-ID');
}

function updFC(fired){
  document.getElementById('fc-trace').innerHTML=fired.map(r=>
    `<div class="fc-item"><div class="fc-num ${r.status}">${r.id}</div><div><div class="fc-rule">IF kondisi_${r.param} → THEN</div><div class="fc-result"><span class="${r.status}">${r.label}</span></div></div></div>`
  ).join('');
  document.getElementById('fc-count').textContent=fired.length+' rule aktif';
}

function updRek(fired){
  const reks=fired.filter(r=>r.rek).map(r=>r.rek);
  document.getElementById('rek-list').innerHTML=reks.length?reks.map(r=>`<div class="rek-item ${r.cls}"><div class="rek-title">${r.title}</div><div class="rek-desc">${r.desc}</div></div>`).join('')
    :`<div class="rek-item ok"><div class="rek-title">Tidak ada tindakan koreksi</div><div class="rek-desc">Semua parameter optimal.</div></div>`;
  document.getElementById('rek-count').textContent=reks.length?reks.length+' tindakan':'semua normal';
}

function updNotif(fired){
  const newOnes=fired.filter(r=>r.status!=='ok'&&!prevFired.find(p=>p.id===r.id));
  newOnes.forEach(r=>{
    localNotifs.unshift({st:r.status,msg:r.label,time:new Date().toLocaleTimeString('id-ID')});
    if(localNotifs.length>30)localNotifs.pop();
    showToast(r.status==='danger'?'err':'warn', (r.status==='danger'?'🔴 ':'⚠ ')+r.label);
  });
  document.getElementById('notif-box').innerHTML=localNotifs.length?localNotifs.map(n=>
    `<div class="notif-item"><div class="notif-dot ${n.st}"></div><div><div class="notif-msg">${n.msg}</div><div class="notif-time">${n.time}</div></div></div>`
  ).join(''):`<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px 0">Belum ada notifikasi</div>`;
}

function clearNotif(){
  localNotifs.length=0;
  document.getElementById('notif-box').innerHTML='<div style="color:var(--text3);font-size:12px;text-align:center;padding:20px 0">Belum ada notifikasi</div>';
}

async function fetchLatestData(){
  if(!dbOk)return;
  try{
    const res=await fetch(API+'/latest');
    const data=await res.json();
    if(Object.keys(data).length>0){
      sp=data.suhu_prod; sc=data.suhu_cool; ph=data.ph; tds=data.tds;
      ['sp','sc','ph','tds'].forEach(k=>{hist[k].push(eval(k));if(hist[k].length>MAX_H)hist[k].shift();});
      const fired=RULES.filter(r=>r.cond({sp,sc,ph,tds}));
      const ov=data.status;
      updCard('sp',sp,paramSt('sp',fired),sp.toFixed(1),prevSp);
      updCard('sc',sc,paramSt('sc',fired),sc.toFixed(1),prevSc);
      updCard('ph',ph,paramSt('ph',fired),ph.toFixed(2),prevPh);
      updCard('tds',tds,paramSt('tds',fired),Math.round(tds),prevTds);
      drawSpark('spark-sp',hist.sp,colOf(paramSt('sp',fired)));
      drawSpark('spark-sc',hist.sc,colOf(paramSt('sc',fired)));
      drawSpark('spark-ph',hist.ph,colOf(paramSt('ph',fired)));
      drawSpark('spark-tds',hist.tds,colOf(paramSt('tds',fired)));
      updBanner(ov,fired); updFC(fired); updRek(fired); updNotif(fired);
      document.getElementById('banner-saved').textContent='✓ Tersambung ke Python DB';
      document.getElementById('banner-saved').className='banner-saved ok';
      prevSp=sp; prevSc=sc; prevPh=ph; prevTds=tds; prevFired=fired;
    }
  }catch(e){}
}

async function refreshLog(){
  if(!dbOk)return;
  try{
    const res=await fetch(API+'/log?limit=20');
    const logs=await res.json();
    const tbody=document.getElementById('log-body');
    if(!logs||!logs.length){tbody.innerHTML='<tr><td colspan="7" style="text-align:center;padding:16px">Belum ada log</td></tr>';return;}
    tbody.innerHTML=logs.map(r=>`
      <tr>
        <td>${r.id}</td><td>${r.waktu.split(' ')[1]}</td><td>${r.suhu_prod}° / ${r.suhu_cool}°</td>
        <td>${r.ph}</td><td>${r.tds}</td>
        <td><span class="log-status ${r.status}">${r.status}</span></td>
        <td>${r.rules_aktif||'—'}</td>
      </tr>`).join('');
  }catch(e){}
}

async function loadStatistik(){
  if(!dbOk)return;
  try{
    const res=await fetch(API+'/stats');
    const d=await res.json();
    document.getElementById('st-total').textContent=d.total;
    document.getElementById('st-normal').textContent=d.normal;
    document.getElementById('st-anomali').textContent=d.anomali;
    document.getElementById('st-kritis').textContent=d.kritis;
  }catch(e){}
}

async function checkDB(){
  try{
    await fetch(API+'/stats',{signal:AbortSignal.timeout(3000)});
    dbOk=true;
    document.getElementById('db-badge').textContent='DB: TERHUBUNG';
    document.getElementById('db-badge').className='db-badge connected';
    fetchLatestData(); refreshLog();
  }catch(e){
    dbOk=false;
    document.getElementById('db-badge').textContent='DB: TERPUTUS';
    document.getElementById('db-badge').className='db-badge disconnected';
  }
}

async function hapusLog(){
  if(!confirm('Hapus semua database?'))return;
  await fetch(API+'/clear',{method:'DELETE'});
  fetchLatestData(); refreshLog();
  showToast('ok','✓ Riwayat log dihapus');
}

